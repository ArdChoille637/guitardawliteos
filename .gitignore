# Circle bare-metal framework — external dependency, pinned to a commit and
# cloned fresh per docs/build-setup.md. Not vendored (GPLv3, ~33MB, upstream
# rsta2/circle). Clone + pin instructions live in docs/build-setup.md.
circle/

# Firmware build artifacts (src/) — regenerate with scripts/build.sh
src/*.o
src/*.d
src/*.elf
src/*.lst
src/*.map
src/*.img

# SD card staging — binaries fetched/generated by scripts/build.sh, not
# authored here. Keep the hand-tuned config.txt / cmdline.txt* (tracked).
sdcard/*.img
sdcard/*.dtb
sdcard/overlays/*.dtbo

# KiCad local/generated cruft
*.kicad_prl
*-backups/
*.bak
fp-info-cache
# KiCad's own local version-history backup (a nested git repo)
kicad/.history/

# macOS
.DS_Store

# Generated preview page (rebuilt on demand, not a source document)
docs/_wiring-preview.html
